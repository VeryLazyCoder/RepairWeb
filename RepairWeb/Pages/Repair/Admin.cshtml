@page
@model RepairWeb.Pages.Repair.AdminModel
@{
    <h1 class="text-center mb-4">Здесь представлены все нераспределённые заявки</h1>

    <div class="container">
        <div class="row">
            @foreach (var request in Model.Requests)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Оборудование: @request.Equipment</h5>
                            <p class="card-text"><strong>Дата создания:</strong> @request.RequestDate.ToString("dd.MM.yyyy")</p>
                            <p class="card-text"><strong>Клиент жалуется на:</strong> @request.ProblemDescription</p>

                            <div class="dropdown">
                                <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="executorDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    -- Выберите исполнителя --
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="executorDropdown" style="max-height: 300px; overflow-y: auto;">
                                    @foreach (var executor in Model.Executors)
                                    {
                                        <li class="p-2">
                                            <div class="d-flex align-items-center">
                                                <img src="@executor.AvatarPath" alt="Profile Image" class="rounded-circle me-2" style="width: 40px; height: 40px;" />
                                                <div>
                                                    <strong>@executor.Name</strong><br />
                                                    <span class="text-muted">
                                                        @executor.AverageRating.ToString("F2") <i class="fas fa-star text-warning"></i>
                                                    </span>
                                                </div>
                                                <form method="post" asp-page-handler="Assign" class="ms-auto">
                                                    <input type="hidden" name="executorId" value="@executor.Id" />
                                                    <input type="hidden" name="requestId" value="@request.RequestId" />
                                                    <button type="submit" class="btn btn-sm btn-primary">
                                                        Назначить исполнителя
                                                    </button>
                                                </form>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="d-flex justify-content-center mt-3">
        <a asp-page="/Admin/Reports" class="btn btn-primary mt-2">Просмотреть отчёты</a>
    </div>
}