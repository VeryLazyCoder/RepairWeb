@page "{id}"
@model RepairWeb.Pages.Client.ReviewModel
@{
    ViewData["Title"] = "Оставить отзыв";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="text-center mb-0">Оставить отзыв</h2>
        </div>
        <div class="card-body">
            <h4 class="card-title text-center mb-4">
                Оборудование: <strong>@Model.Request.Equipment</strong>
            </h4>
            <p class="card-text">
                <strong>Описание проблемы:</strong> @Model.Request.ProblemDescription
            </p>
            <p class="card-text">
                <strong>Комментарий мастера:</strong> @Model.Request.ExecutorComment
            </p>

            <form method="post">
                <div class="form-group">
                    <label for="Rating" class="form-label">Оценка мастера</label>
                    <div class="rating" id="starRating">
                        @for (int i = 1; i <= 10; i++)
                        {
                            <i class="far fa-star" data-value="@i"></i>
                        }
                    </div>
                    <input type="hidden" name="Rating" id="ratingInput" value="0">
                    <input type="hidden" name="requestId" value="@Model.Request.Id" />
                </div>

                <div class="form-group mt-4">
                    <label for="ReviewText" class="form-label">Ваш отзыв</label>
                    <textarea class="form-control" id="ReviewText" name="Comment" rows="4" placeholder="Напишите свой отзыв">@Model.Input.Comment</textarea>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-success btn-lg">Отправить отзыв</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .container {
        max-width: 700px;
    }

    .rating {
        font-size: 2rem;
        color: #ffd700;
        display: flex;
        justify-content: center;
        margin-top: 10px;
    }

        .rating i {
            cursor: pointer;
            margin-right: 5px;
            transition: color 0.3s ease-in-out;
        }

            .rating i:hover,
            .rating i.fas {
                color: #ff9800;
            }

    .card {
        border-radius: 10px;
    }

    .card-header {
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const stars = document.querySelectorAll('.rating i');
        const ratingInput = document.getElementById('ratingInput');

        stars.forEach(star => {
            star.addEventListener('click', function () {
                const rating = this.getAttribute('data-value');

                // Устанавливаем значение в скрытое поле input
                ratingInput.value = rating;

                // Обновляем визуально выбранные звёзды
                stars.forEach((s, index) => {
                    if (index < rating) {
                        s.classList.remove('far');
                        s.classList.add('fas'); // Закрашенная звезда
                    } else {
                        s.classList.remove('fas');
                        s.classList.add('far'); // Пустая звезда
                    }
                });
            });

            // Подсветка звёзд при наведении мыши
            star.addEventListener('mouseover', function () {
                const rating = this.getAttribute('data-value');
                stars.forEach((s, index) => {
                    if (index < rating) {
                        s.classList.add('hover');
                    } else {
                        s.classList.remove('hover');
                    }
                });
            });

            // Сброс подсветки при уходе мыши
            star.addEventListener('mouseout', function () {
                stars.forEach(s => {
                    s.classList.remove('hover');
                });
            });
        });
    });
</script>
